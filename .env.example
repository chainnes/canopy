# mock runs the demo with no API key. openai uses any OpenAI-compatible chat endpoint
# (OpenAI, Groq, Ollama at http://127.0.0.1:11434/v1, or a LiteLLM proxy).
LLM_PROVIDER=mock

# Used only when LLM_PROVIDER=openai.
# Examples: https://api.openai.com/v1  |  https://api.groq.com/openai/v1  |  http://127.0.0.1:11434/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Required for POST /api/webhooks/inbound and POST /api/triggers/morning-brief.
# Local placeholder only, not a credential. Replace it before any shared deploy.
# If this is left unset, development uses the same placeholder; production stays closed.
TRIGGER_TOKEN=dev-trigger-token

# Optional. When set, a confirmed webhook draft is POSTed here.
# Confirmed email is always simulated. There is no mail provider in this slice.
OUTBOUND_WEBHOOK_URL=

# Local hour (0-23) for the in-process morning brief. Asia/Manila is UTC+8.
MORNING_BRIEF_HOUR=8
APP_TIMEZONE=Asia/Manila

# JSON file for the desk. On a container host, point this at a mounted volume.
DATA_PATH=./data/canopy.json

# Desk buttons (reset, sample inquiry, morning brief) are on for local demo.
# Set false if the port is reachable by anyone else.
DEMO_UI=true

# In-process scheduler. Leave false for a predictable demo; use the trigger endpoint or the button.
SCHEDULER_ENABLED=false

# local uses the deterministic hash embedder. openai calls POST {LLM-style}/embeddings.
# Vectors are not mixed: switching provider means resetting the desk file.
EMBEDDING_PROVIDER=local
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nomic-embed-text
